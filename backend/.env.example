# Copier ce fichier en .env pour le développement local (hors Docker).
# En Docker, ces valeurs sont fournies par le fichier .env à la racine du
# dépôt et injectées dans docker-compose.yml.

DATABASE_URL=postgresql://elj:elj_password_a_changer@localhost:5432/elj
JWT_SECRET=change-me-with-a-long-random-value
PORT=3000
NODE_ENV=development

# Origines autorisées en CORS, séparées par des virgules. Non défini = tout
# autorisé (pratique en développement, à restreindre en production).
CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=./uploads
