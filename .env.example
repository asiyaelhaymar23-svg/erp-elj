# Copier ce fichier en .env à la racine avant `docker compose up` et
# remplacer les valeurs marquées "a_changer" / "change-me".

# --- PostgreSQL ---
POSTGRES_DB=elj
POSTGRES_USER=elj
POSTGRES_PASSWORD=elj_password_a_changer

# --- Backend ---
JWT_SECRET=change-me-with-a-long-random-value
CORS_ORIGIN=http://localhost:8080
BACKEND_PORT=3000

# --- Frontend ---
# URL de l'API telle qu'accessible depuis le navigateur de l'utilisateur
# (pas depuis l'intérieur du réseau Docker).
VITE_API_URL=http://localhost:3000
FRONTEND_PORT=8080
